#!/usr/bin/env python3
"""Every commit answers the four questions a 2 a.m. recovery asks (P4 W6).

Enable once:  git config core.hooksPath .githooks

    Schema: 0039 | none          which migration ships with this
    Restart: required | none     does the running being need to be restarted
    Class: A | B                 test-suite-judgeable, or only the being can judge
    Semantics: yes | no          does a stored value MEAN something new

`Semantics: yes` is the one that matters. Expand-contract protects the schema,
not the meaning: a commit that changes what a `provenance` value or a claim
score means cannot be crossed backwards without restoring the paired snapshot,
at the cost of the being's life since. E8.2's runner reads these; history
written before them is history it cannot read, which is why they start now
rather than when the runner exists.
"""
import re
import sys

RULES = {
    "Schema": r"(none|\d{4}(\s*,\s*\d{4})*)",
    "Restart": r"(required|none)",
    "Class": r"(A|B)",
    "Semantics": r"(yes|no)",
}

text = open(sys.argv[1], encoding="utf-8").read()
if text.lstrip().startswith(("Merge ", "Revert ", "fixup!", "squash!")):
    sys.exit(0)

missing = [f"{name}: {pattern.replace('|', ' | ')}"
           for name, pattern in RULES.items()
           if not re.search(rf"^{name}: {pattern}\s*$", text, re.M)]
if missing:
    print("commit refused — the recovery trailers are missing or malformed:\n")
    for line in missing:
        print(f"    {line}")
    print("\nOne line each, at the end of the message. `Semantics: yes` means a")
    print("stored value means something new, and cannot be crossed backwards")
    print("without restoring the snapshot that precedes it.")
    sys.exit(1)
