#!/bin/sh
# The gate, before the commit exists (P4 E8.0 / W5).
#
# Enable once:  git config core.hooksPath .githooks
#
# On 2026-08-19 a commit went in red because nothing ran the suite. This is
# what runs it. It is ~90 seconds and that is the price of the claim.
#
# `git commit --no-verify` skips it. That is not a hole to be plugged here:
# the loop will run as this user and a local hook was never a boundary against
# it (RT5). The refusal that binds a builder is E8.4's.
set -e

python -c "import newz" 2>/dev/null || {
    echo "gate: cannot import newz — wrong environment?"
    echo "      conda activate newz   (or agent13), then commit again"
    exit 1
}
exec python tools/gate.py
